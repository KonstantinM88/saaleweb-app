# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saaleweb?schema=public"
# Maximum PostgreSQL connections per Next.js process/build worker.
# Keep this at 1 on Hostinger with the free Neon pooled endpoint to prevent
# concurrent cold processes from exhausting connection permits.
DATABASE_POOL_MAX="1"

# Public site URL (used for canonical URLs, sitemap, hreflang)
NEXT_PUBLIC_SITE_URL="https://saaleweb.de"
# Public base URL for images embedded in transactional emails.
# Keep this public/HTTPS even during local tests because inbox clients cannot fetch localhost images.
EMAIL_ASSET_BASE_URL="https://saaleweb.de"

# Stabilizes Next.js Server Action IDs across self-hosted builds/instances.
# Required on Hostinger when forms may be submitted across restarts or multiple app processes.
# Generate once and keep the same value in production:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Public direct-contact channels shown on the website.
NEXT_PUBLIC_CONTACT_PHONE="+4917671764743"
NEXT_PUBLIC_WHATSAPP_URL="https://wa.me/4917671764743"
# Prefer a username link like "https://t.me/your_username" when available.
NEXT_PUBLIC_TELEGRAM_URL="https://t.me/+4917671764743"

# Cloudflare Turnstile spam protection for every public lead form.
# Create one Managed widget for saaleweb.de (and www.saaleweb.de if used).
# The public site key is embedded at build time; the secret stays server-only.
# If both values are empty, Turnstile is disabled. A partial configuration fails closed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Admin authentication
# AUTH_SECRET signs admin session cookies. Use a random 32+ character value, not your password or bcrypt hash.
AUTH_SECRET=""
ADMIN_EMAIL=""
# Generate with: node scripts/hash-password.mjs "your-password"
# Bcrypt hashes contain "$"; in Next.js .env files each "$" must be escaped as "\$".
ADMIN_PASSWORD_HASH=""

# Optional production media storage for admin uploads.
# Vercel Blob writes use this token; without it local dev falls back to public/uploads.
BLOB_READ_WRITE_TOKEN=""

# Optional transactional email provider.
# MAIL_PROVIDER:
# - auto: use Resend when RESEND_API_KEY is set, otherwise SMTP
# - resend: force Resend
# - smtp: force Hostinger SMTP
MAIL_PROVIDER="auto"
RESEND_API_KEY=""
RESEND_FROM=""

# Optional email notifications through Hostinger SMTP.
# Keep public From addresses on the authenticated mailbox/domain so DKIM/DMARC alignment stays valid.
# In Hostinger hPanel, paste environment values without surrounding single or double quotes.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="mykhailov@saaleweb.de"
SMTP_PASSWORD=""
SMTP_FROM="SaaleWeb <mykhailov@saaleweb.de>"
LEAD_NOTIFY_FROM=""
LEAD_NOTIFY_TO=""
# Optional newsletter sender; for SMTP keep it on the authenticated mailbox/domain.
NEWSLETTER_FROM=""

# Optional Telegram admin notifications and daily traffic report.
# Create a bot through @BotFather, then send your bot one message and read chat.id via getUpdates.
# TELEGRAM_ADMIN_CHAT_ID supports one or multiple IDs separated by comma or spaces.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
# Required for Telegram commands/webhook. Set the same value as Telegram webhook secret_token.
TELEGRAM_WEBHOOK_SECRET=""
# Required for the cron endpoint: /api/telegram/daily-report?secret=...
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_REPORT_SECRET=""
TELEGRAM_REPORT_TIMEZONE="Europe/Berlin"
# Optional cooldown for repeated health-alert messages with the same issue.
TELEGRAM_HEALTH_ALERT_COOLDOWN_MINUTES="60"

# Optional internal secret for AI crawler tracking; falls back to AUTH_SECRET.
AI_TRAFFIC_INGEST_SECRET=""

# Optional public AI assistant. Keep the API key server-only.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"

# Optional analytics salt for daily unique-visitor hashes.
# If empty, AUTH_SECRET is used as fallback. Do not commit real production salts.
ANALYTICS_SALT=""

# Public Google Tag Manager / GA4 identifiers. GA4 is configured inside GTM;
# do not also mount the standalone GoogleAnalytics component.
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Optional daily SEO Score integrations for Telegram.
# PageSpeed enables mobile Lighthouse and CrUX field metrics.
PAGESPEED_API_KEY=""
# Server-only Google Business review synchronization through Places API (New).
# Prefer a dedicated restricted key. When empty, the server can reuse PAGESPEED_API_KEY.
GOOGLE_PLACES_API_KEY=""
# Optional override; the verified public Place ID is already stored in siteConfig.
GOOGLE_BUSINESS_PLACE_ID="ChIJpZR1A7F9pkcRCA-KPZsTnIs"
# Search Console service-account credentials enable indexation, CTR and query data.
# GSC_SITE_URL must exactly match the property shared with the service account,
# for example https://saaleweb.de/ or sc-domain:saaleweb.de.
GSC_CLIENT_EMAIL=""
# Preferred for hosting platforms
GSC_PRIVATE_KEY_BASE64=""
# Legacy PEM format with escaped newlines
GSC_PRIVATE_KEY=""
GSC_SITE_URL="https://saaleweb.de/"
# IndexNow notifies Bing and participating search engines about priority URL changes.
# Generate once with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Add the same value to Hostinger; the app publishes it at /indexnow-key.txt.
INDEXNOW_KEY=""
# Google Analytics Data API server reporting.
# Reuses the Google service-account credentials above; never expose them as NEXT_PUBLIC_*.
GA4_PROPERTY_ID="545228440"
