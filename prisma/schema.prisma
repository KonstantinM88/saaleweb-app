// SaaleWeb — Prisma schema
// PostgreSQL. Content is multilingual via dedicated *Translation tables.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  de
  en
  ru
}

enum UserRole {
  ADMIN
  EDITOR
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum RequestType {
  CONTACT
  QUOTE
  CONSULTATION
  AUDIT
}

// ---------------------------------------------------------------------------
// People / auth
// ---------------------------------------------------------------------------

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  role      UserRole   @default(EDITOR)
  posts     BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Author {
  id           String              @id @default(cuid())
  name         String
  avatarUrl    String?
  posts        BlogPost[]
  translations AuthorTranslation[]
  createdAt    DateTime            @default(now())
}

model AuthorTranslation {
  id       String @id @default(cuid())
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String
  locale   Locale
  role     String
  bio      String

  @@unique([authorId, locale])
}

// ---------------------------------------------------------------------------
// Leads & forms
// ---------------------------------------------------------------------------

model Lead {
  id                    String                 @id @default(cuid())
  submissionId          String?                @unique
  name                  String
  email                 String?
  phone                 String?
  company               String?
  message               String?
  source                String?
  status                LeadStatus             @default(NEW)
  locale                Locale                 @default(de)
  createdAt             DateTime               @default(now())
  attribution           LeadAttribution?
  assistantConversation AssistantConversation?
}

model LeadAttribution {
  id     String @id @default(cuid())
  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  firstSource      String?
  firstMedium      String?
  firstChannel     String?
  firstCampaign    String?
  firstContent     String?
  firstTerm        String?
  firstLandingPage String?
  firstReferrer    String?
  firstGclid       String?
  firstFbclid      String?
  firstMsclkid     String?
  firstCapturedAt  DateTime?

  lastSource      String?
  lastMedium      String?
  lastChannel     String?
  lastCampaign    String?
  lastContent     String?
  lastTerm        String?
  lastLandingPage String?
  lastReferrer    String?
  lastGclid       String?
  lastFbclid      String?
  lastMsclkid     String?
  lastCapturedAt  DateTime?

  conversionPage String?
  deviceCategory String?
  captureMode    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firstSource])
  @@index([lastSource])
  @@index([firstCampaign])
  @@index([lastCampaign])
  @@index([firstLandingPage])
  @@index([conversionPage])
}

model ContactRequest {
  id        String      @id @default(cuid())
  type      RequestType @default(CONTACT)
  name      String
  email     String
  phone     String?
  company   String?
  budget    String?
  message   String?
  locale    Locale      @default(de)
  handled   Boolean     @default(false)
  createdAt DateTime    @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    Locale   @default(de)
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Projects / case studies
// ---------------------------------------------------------------------------

model ProjectCategory {
  id           String                       @id @default(cuid())
  key          String                       @unique
  projects     Project[]
  translations ProjectCategoryTranslation[]
}

model ProjectCategoryTranslation {
  id         String          @id @default(cuid())
  category   ProjectCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  locale     Locale
  name       String

  @@unique([categoryId, locale])
}

model Project {
  id           String               @id @default(cuid())
  category     ProjectCategory?     @relation(fields: [categoryId], references: [id])
  categoryId   String?
  coverColor   String?
  technologies String[]
  resultValue  String?
  year         Int?
  featured     Boolean              @default(false)
  published    Boolean              @default(false)
  order        Int                  @default(0)
  translations ProjectTranslation[]
  media        Media[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model ProjectTranslation {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  locale    Locale
  title     String
  slug      String
  challenge String?
  solution  String?
  results   String?

  @@unique([projectId, locale])
  @@unique([locale, slug])
}

model PricingPlan {
  id           String                   @id @default(cuid())
  featured     Boolean                  @default(false)
  published    Boolean                  @default(true)
  order        Int                      @default(0)
  translations PricingPlanTranslation[]
}

model PricingPlanTranslation {
  id       String      @id @default(cuid())
  plan     PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId   String
  locale   Locale
  name     String
  sub      String?
  price    String
  features String[]

  @@unique([planId, locale])
}

// ---------------------------------------------------------------------------
// Services & industries
// ---------------------------------------------------------------------------

model Service {
  id           String               @id @default(cuid())
  icon         String?
  coverImage   String?
  published    Boolean              @default(true)
  order        Int                  @default(0)
  translations ServiceTranslation[]
}

model ServiceTranslation {
  id        String  @id @default(cuid())
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String
  locale    Locale
  name      String
  slug      String
  excerpt   String?
  content   String?

  @@unique([serviceId, locale])
  @@unique([locale, slug])
}

model Industry {
  id           String                @id @default(cuid())
  emoji        String?
  coverImage   String?
  published    Boolean               @default(true)
  order        Int                   @default(0)
  translations IndustryTranslation[]
}

model IndustryTranslation {
  id         String   @id @default(cuid())
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)
  industryId String
  locale     Locale
  name       String
  slug       String
  excerpt    String?
  content    String?

  @@unique([industryId, locale])
  @@unique([locale, slug])
}

// ---------------------------------------------------------------------------
// FAQ
// ---------------------------------------------------------------------------

model Faq {
  id           String           @id @default(cuid())
  category     String?
  published    Boolean          @default(true)
  order        Int              @default(0)
  translations FaqTranslation[]
}

model FaqTranslation {
  id       String @id @default(cuid())
  faq      Faq    @relation(fields: [faqId], references: [id], onDelete: Cascade)
  faqId    String
  locale   Locale
  question String
  answer   String

  @@unique([faqId, locale])
}

// ---------------------------------------------------------------------------
// Blog
// ---------------------------------------------------------------------------

model BlogCategory {
  id           String                    @id @default(cuid())
  key          String                    @unique
  posts        BlogPost[]
  translations BlogCategoryTranslation[]
}

model BlogCategoryTranslation {
  id         String       @id @default(cuid())
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  locale     Locale
  name       String
  slug       String

  @@unique([categoryId, locale])
  @@unique([locale, slug])
}

model BlogPost {
  id           String                @id @default(cuid())
  author       Author?               @relation(fields: [authorId], references: [id])
  authorId     String?
  user         User?                 @relation(fields: [userId], references: [id])
  userId       String?
  category     BlogCategory?         @relation(fields: [categoryId], references: [id])
  categoryId   String?
  coverImage   String?
  readingTime  Int?
  published    Boolean               @default(false)
  publishedAt  DateTime?
  translations BlogPostTranslation[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model BlogPostTranslation {
  id      String   @id @default(cuid())
  post    BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId  String
  locale  Locale
  title   String
  slug    String
  excerpt String?
  content String

  @@unique([postId, locale])
  @@unique([locale, slug])
}

// ---------------------------------------------------------------------------
// Testimonials
// ---------------------------------------------------------------------------

model Testimonial {
  id           String                   @id @default(cuid())
  rating       Int                      @default(5)
  avatarUrl    String?
  published    Boolean                  @default(true)
  order        Int                      @default(0)
  translations TestimonialTranslation[]
}

model TestimonialTranslation {
  id            String      @id @default(cuid())
  testimonial   Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade)
  testimonialId String
  locale        Locale
  quote         String
  clientName    String
  company       String?

  @@unique([testimonialId, locale])
}

// ---------------------------------------------------------------------------
// SEO, media, settings, generic UI translations
// ---------------------------------------------------------------------------

model SEOPage {
  id           String               @id @default(cuid())
  path         String               @unique
  translations SEOPageTranslation[]
  updatedAt    DateTime             @updatedAt
}

model SEOPageTranslation {
  id          String  @id @default(cuid())
  page        SEOPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId      String
  locale      Locale
  title       String
  description String
  ogImage     String?

  @@unique([pageId, locale])
}

model PageView {
  id          String   @id @default(cuid())
  path        String
  locale      String
  referrer    String?
  visitorHash String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([visitorHash])
}

model AiBotVisit {
  id        String   @id @default(cuid())
  bot       String
  path      String
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([bot])
  @@index([path])
}

model AssistantConversation {
  id                 String             @id @default(cuid())
  visitorKey         String
  ipAddress          String?
  ipHash             String?
  userAgent          String?
  country            String?
  city               String?
  region             String?
  timezone           String?
  locale             Locale             @default(de)
  responseLocale     Locale             @default(de)
  pagePath           String?
  messageCount       Int                @default(0)
  lastMessageAt      DateTime           @default(now())
  telegramNotifiedAt DateTime?
  salesProfile       Json?
  funnelStage        String             @default("DISCOVERY")
  leadId             String?            @unique
  lead               Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  messages           AssistantMessage[]

  @@index([visitorKey])
  @@index([ipAddress])
  @@index([ipHash])
  @@index([createdAt])
  @@index([lastMessageAt])
  @@index([telegramNotifiedAt])
}

model AssistantMessage {
  id             String                @id @default(cuid())
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  role           String
  content        String
  model          String?
  scoped         Boolean?
  responseLocale Locale?
  createdAt      DateTime              @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model BlockedIp {
  id        String   @id @default(cuid())
  ipAddress String   @unique
  reason    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Media {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  width     Int?
  height    Int?
  order     Int      @default(0)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?
  createdAt DateTime @default(now())
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// Generic key-value UI translations (namespace.key per locale)
model Translation {
  id        String   @id @default(cuid())
  namespace String
  key       String
  locale    Locale
  value     String
  updatedAt DateTime @updatedAt

  @@unique([namespace, key, locale])
}

model SeoDailySnapshot {
  id          String   @id @default(cuid())
  day         String   @unique
  score       Int
  sitemapUrls Int
  report      String
  createdAt   DateTime @default(now())
}

model AiVisibilityCheck {
  id           String   @id @default(cuid())
  week         String
  promptKey    String
  platform     String
  mentioned    Boolean  @default(false)
  cited        Boolean  @default(false)
  mentionOrder Int?
  citationUrl  String?
  competitor   String?
  notes        String?
  checkedAt    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([week, promptKey, platform])
  @@index([week])
  @@index([platform])
  @@index([promptKey])
}
